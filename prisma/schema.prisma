datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("admin") // "super_admin", "admin", "moderator"
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]
}

model Product {
  id                 String           @id @default(uuid())
  slug               String           @unique
  name               String
  brand              String           @default("Havells")
  modelName          String           @default("Zella")
  subtitle           String
  description        String
  originalPrice      Float
  sellingPrice       Float
  discountPercentage Float
  stockQuantity      Int              @default(50)
  isInStock          Boolean          @default(true)
  isFeatured         Boolean          @default(true)
  metaTitle          String?
  metaDescription    String?
  warrantyInfo       String?
  boxContents        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  images             ProductImage[]
  features           ProductFeature[]
  specs              ProductSpec[]
  orderItems         OrderItem[]
  reviews            Review[]
  inventoryLogs      InventoryHistory[]
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  url          String
  altText      String?
  displayOrder Int      @default(0)
  isThumbnail  Boolean  @default(false)
  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductFeature {
  id           String   @id @default(uuid())
  productId    String
  title        String
  description  String
  icon         String   @default("Zap")
  displayOrder Int      @default(0)
  isVerified   Boolean  @default(true)
  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id           String   @id @default(uuid())
  productId    String
  label        String
  value        String
  category     String   @default("General") // "General", "Electrical", "Build", "Safety"
  displayOrder Int      @default(0)
  isVerified   Boolean  @default(true)
  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general") // "general", "branding", "contact", "announcement", "social"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id          String   @id @default(uuid())
  sectionKey  String   @unique // "hero", "why_buy_us", "safety_guide", "policy_privacy", "policy_terms", "policy_shipping", "policy_refund", "policy_warranty"
  title       String?
  contentJson String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FaqItem {
  id           String   @id @default(uuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  phone       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders      Order[]
  addresses   Address[]
}

model Address {
  id          String   @id @default(uuid())
  customerId  String
  fullName    String
  phone       String
  houseNumber String
  street      String
  landmark    String?
  city        String
  state       String
  pincode     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Order {
  id                  String               @id @default(uuid())
  orderNumber         String               @unique // e.g. "ORD-2026-1001"
  customerId          String?
  customerName        String
  customerEmail       String
  customerPhone       String
  shippingAddressJson String
  originalAmount      Float
  discountAmount      Float                @default(0)
  couponDiscount      Float                @default(0)
  shippingFee         Float                @default(0)
  finalAmount         Float
  paymentMethod       String               @default("UPI") // "UPI", "COD"
  paymentStatus       String               @default("PENDING") // "PENDING", "PENDING_VERIFICATION", "PAID", "FAILED", "REJECTED", "REFUNDED"
  orderStatus         String               @default("PENDING") // "PENDING", "PAYMENT_PENDING", "PAYMENT_VERIFICATION", "CONFIRMED", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED", "REFUNDED"
  adminNotes          String?
  invoiceNumber       String?
  accessToken         String               @unique @default(uuid()) // Unguessable token for secure customer tracking
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  paymentAttempts     PaymentAttempt[]
  paymentEvents       PaymentEvent[]
  couponUsages        CouponUsage[]
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  unitPrice    Float
  quantity     Int     @default(1)
  totalAmount  Float
  productImage String?

  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String
  fromStatus String
  toStatus   String
  note       String?
  updatedBy  String   @default("System")
  createdAt  DateTime @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentAttempt {
  id               String         @id @default(uuid())
  orderId          String
  idempotencyKey   String         @unique
  gateway          String         @default("YOUPI_PG")
  gatewayPaymentId String?
  checkoutUrl      String?
  amount           Float
  currency         String         @default("INR")
  status           String         @default("ACTIVE") // "ACTIVE", "OBSERVED", "VERIFIED", "EXPIRED", "FAILED"
  rawResponseJson  String?
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events           PaymentEvent[]
}

model PaymentEvent {
  id                 String          @id @default(uuid())
  paymentAttemptId   String?
  orderId            String
  eventType          String          // "OBSERVED_SUCCESS", "RECONCILED", "MANUAL_REVIEW", "SUCCESS", "FAILED"
  signature          String?
  utr                String?
  amount             Float?
  settlementState    String?         // "NOT_RECONCILED", "RECONCILED"
  rawPayloadJson     String
  processed          Boolean         @default(false)
  verificationStatus String          @default("PENDING") // "PENDING", "VERIFIED", "REJECTED", "INVESTIGATION"
  verificationNote   String?
  verifiedBy         String?
  verifiedAt         DateTime?
  createdAt          DateTime        @default(now())

  paymentAttempt     PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentSetting {
  id                  String   @id @default(uuid())
  gatewayName         String   @unique @default("YOUPI_PG")
  isUpiEnabled        Boolean  @default(true)
  isCodEnabled        Boolean  @default(true)
  isTestMode          Boolean  @default(true)
  merchantId          String   @default("youpi_merchant_test_01")
  maskedApiKey        String   @default("yk_test_••••••••••••3421")
  maskedWebhookSecret String   @default("ws_test_••••••••••••9812")
  customerReturnUrl   String   @default("http://localhost:3000/checkout/verification")
  allowedMethods      String   @default("MANUAL_UPI,COD")
  updatedAt           DateTime @updatedAt
}

model Review {
  id                 String                    @id @default(uuid())
  productId          String
  customerName       String
  customerEmail      String
  rating             Int                       // 1 to 5
  title              String
  comment            String
  imageUrl           String?
  isVerifiedPurchase Boolean                   @default(false)
  status             String                    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  moderationNote     String?
  moderatedBy        String?
  moderatedAt        DateTime?
  isDemoData         Boolean                   @default(false) // Demo seed data isolated, never published to storefront
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  product            Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  moderationHistory  ReviewModerationHistory[]
}

model ReviewModerationHistory {
  id         String   @id @default(uuid())
  reviewId   String
  action     String   // "APPROVED", "REJECTED", "DELETED", "NOTE_ADDED"
  reason     String?
  adminName  String
  createdAt  DateTime @default(now())

  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Coupon {
  id               String        @id @default(uuid())
  code             String        @unique
  description      String?
  discountType     String        @default("PERCENTAGE") // "PERCENTAGE", "FIXED"
  discountValue    Float
  maxDiscountAmount Float?
  minCartValue     Float         @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  usageLimit       Int?
  timesUsed        Int           @default(0)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  usages           CouponUsage[]
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  orderId         String
  customerEmail   String
  discountApplied Float
  createdAt       DateTime @default(now())

  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model InventoryHistory {
  id           String   @id @default(uuid())
  productId    String
  changeAmount Int
  reason       String   // "INITIAL_STOCK", "ORDER_PLACED", "ORDER_CANCELLED", "MANUAL_ADJUSTMENT"
  newQuantity  Int
  updatedBy    String   @default("System")
  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String?
  adminEmail  String
  action      String   // e.g. "PRODUCT_UPDATE", "PRICE_UPDATE", "ORDER_STATUS_CHANGE", "REVIEW_APPROVED", "PAYMENT_VERIFIED"
  entityType  String   // "Product", "Order", "Review", "Payment", "Setting", "Coupon"
  entityId    String?
  detailsJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
}
