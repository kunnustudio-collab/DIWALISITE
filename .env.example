# Database Connection
# Local SQLite: "file:./dev.db"
# PostgreSQL / Supabase: "postgresql://postgres:password@localhost:5432/zella_db?schema=public"
DATABASE_URL="file:./dev.db"

# Session & JWT Secret (minimum 32 random characters)
JWT_SECRET="replace-with-a-random-secure-secret-key-min-32-chars"
ADMIN_SESSION_COOKIE="zella_admin_session_token"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# YouPI-PG Gateway (Self-hosted or hosted YouPI-PG instance)
YOUPI_API_URL="http://localhost:6100"
YOUPI_MERCHANT_ID="your_youpi_merchant_id_uuid"
YOUPI_MERCHANT_API_KEY="your_youpi_merchant_api_key"
YOUPI_WEBHOOK_SECRET="your_youpi_webhook_signing_secret"
CUSTOMER_RETURN_URL="https://yourstore.com/checkout/verification"

# Initial Admin Credentials (used by scripts/seed.mjs on initial setup)
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="ChangeMeOnFirstLogin123!"
INITIAL_ADMIN_NAME="Store Administrator"
